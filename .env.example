# ==========================================
# CueTube Environment Configuration Example
# ==========================================

# --- Google OAuth Credentials (YouTube & Google Calendar) ---
# Note: A single Google OAuth 2.0 Desktop client can provide access to both YouTube and Calendar.
# GOOGLE_* or YOUTUBE_* credentials will automatically be shared by both adapters.
# Run `python3 scripts/get_youtube_token.py -f client_secret.json` to obtain these automatically.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# --- OpenRouter LLM Classification ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Testing Configuration ---
# Set to 1 to enable live API integration tests against external endpoints
RUN_LIVE_TESTS=0

# --- Pipeline & Scheduling Configurables ---
# Custom intake playlist title or direct playlist ID (default: Queue-Inbox)
CUETUBE_INBOX=Queue-Inbox

# Number of concurrent worker threads for transcript extraction & LLM triage (default: 4)
CUETUBE_CONCURRENCY=4

# Operational buffer minutes per scheduled video (default: 15)
CUETUBE_BUFFER_MINUTES=15

# Number of days forward to search calendar availability (default: 7)
CUETUBE_PLANNING_DAYS=7

# Comma-separated Google Calendar IDs to query for busy/free availability (default: primary)
CUETUBE_CALENDAR_IDS=primary

# Target calendar to insert scheduled events into.
# Can be a calendar name (e.g. "CueTube" - will be auto-created if missing) or a specific calendar ID.
# Keeps events isolated in a separate calendar that can be toggled on/off in Google Calendar.
CUETUBE_TARGET_CALENDAR=CueTube

# Include all user-accessible and shared Google Calendars: 0/1 or true/false (default: 0)
CUETUBE_ALL_CALENDARS=0

# Default export file path for iCalendar (.ics) or JSON (optional, e.g. schedule.ics)
# CUETUBE_EXPORT_PATH=schedule.ics

# Require interactive user confirmation before mutating calendar or playlists: 0/1 (default: 0)
# CUETUBE_CONFIRM=0

# Execute pipeline without modifying calendar or playlists: 0/1 (default: 0)
# CUETUBE_DRY_RUN=0

# Move scheduled videos to categorized destination playlists on YouTube: 0/1 (default: 1)
# Set to 0 to only schedule events in Google Calendar without modifying YouTube playlists.
# CUETUBE_RELOCATE_PLAYLISTS=1

# Optional path to Google Takeout archive or CSV file to use as intake source
# CUETUBE_TAKEOUT_PATH=watch-later.csv

# Background daemon polling interval in minutes (default: 60)
CUETUBE_DAEMON_INTERVAL_MINUTES=60

# --- Circadian & Calendar Event Formatting ---
# Google Calendar colorId for energy levels (11=Flamingo/High, 5=Banana/Medium, 2=Sage/Low)
# CUETUBE_COLOR_MORNING=11
# CUETUBE_COLOR_AFTERNOON=5
# CUETUBE_COLOR_EVENING=2

# Circadian window hours (24h format)
# CUETUBE_MORNING_START=9
# CUETUBE_MORNING_END=12
# CUETUBE_AFTERNOON_START=13
# CUETUBE_AFTERNOON_END=17
# CUETUBE_EVENING_START=17
# CUETUBE_EVENING_END=21

# Minimum duration for an available calendar slot in minutes (default: 15)
# CUETUBE_MIN_SLOT_MINUTES=15

# Google Calendar event title prefix (default: 'CueTube: ')
# CUETUBE_EVENT_PREFIX="CueTube: "

# Recurring daily blackout windows to exclude from scheduling.
# Supports comma-separated intervals, days of week, and prefixes:
# e.g. 12:00-13:00,16:30-17:00 or weekday:12:00-13:00 or 10:00-12:00@weekend
# CUETUBE_BLACKOUT_WINDOWS=12:00-13:00,17:00-18:00
