# ==========================================
# CueTube Environment Configuration Example
# ==========================================

# --- YouTube Data API v3 OAuth Credentials ---
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# --- OpenRouter LLM Classification ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Testing Configuration ---
# Set to 1 to enable live API integration tests against external endpoints
RUN_LIVE_TESTS=0
